# Copier ce fichier en « .env » à la racine du projet et remplir.
# Sur Netlify, ces valeurs se mettent dans Site configuration → Environment variables.

# Identifiant du projet Sanity (https://www.sanity.io/manage) — pas secret.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Jeton d'écriture (rôle « Editor ») — SECRET : ne jamais le partager ni le commiter.
# Sert à l'import initial du contenu et au formulaire du livre d'or.
SANITY_WRITE_TOKEN=
