# Copier ce fichier en « .env » (dans le dossier studio) et remplir :
# identifiant du projet, visible sur https://www.sanity.io/manage
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Adresse d'intégration du rapport Looker Studio (onglet « Statistiques »).
# Looker Studio → Fichier → Intégrer le rapport → Activer → copier l'URL.
SANITY_STUDIO_STATS_URL=
