---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const ateliers = [
  ['Ateliers démonstratifs', 'Filage, tissage et teinture végétale, montrés et commentés sur un stand où le public peut essayer.', 'Atelier-explicatif_IJXv.png', 'Atelier démonstratif : outils et fibres présentés au public', 'demonstratifs'],
  ['Tissage aux tablettes', 'Une technique ancienne à essayer : avec de petites tablettes percées, chacun réalise son propre galon.', 'Tissage-aux-tablettes-_XP-ceinture-statues-menhirs__IJXv.jpg', 'Tissage aux tablettes', 'tablettes'],
  ['Ateliers enfants', 'Tissage sur carton et jeux de manipulation : les enfants découvrent le textile en expérimentant, selon leur âge.', 'Atelier-enfant_IJXv.jpg', 'Enfant pendant un atelier de tissage', 'enfants'],
  ['Expérimentation archéologique', 'Pour les archéologues et les chercheurs : tester les gestes, les outils et les hypothèses de la production textile.', 'Jean-Vaquer_-Michel-Maille-et-une-statue-menhir_IJXv.jpg', 'Jean Vaquer et Michel Maillé devant une statue-menhir', 'experimentation'],
  ['Conférences', 'Les textiles anciens, leurs techniques et leur place dans les sociétés du passé, à la lumière de la recherche.', 'Conference-communication_IJXv.jpg', 'Conférence sur les textiles anciens', 'conferences'],
  ['Ateliers accessibles', 'Fibres et tissus à toucher pour les publics aveugles ou malvoyants, matières douces et rythme calme pour les enfants autistes.', 'Atelier-explicatif-2_IJXv.jpg', 'Atelier textile accessible', 'accessibles'],
];

const dates = [
  ['14', 'NOV.', 'Teinture végétale', 'Musée mystérieux – Familles'],
  ['28', 'NOV.', 'Tissage aux tablettes', 'Musée intriguant – Ados et adultes'],
  ['06', 'MARS', 'Ateliers démonstratifs', 'Musée inconnu – Tout public'],
];
---
<BaseLayout title="Neotisse - Neotisse" description="asso.neotisse@gmail.com">
  <section class="hero">
    <img src="/images/Tissage-fleche-_XP-ceinture-statues-menhirs__IJXv.jpg" alt="" fetchpriority="high" />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1>Remonter le temps,<br />au fil de nos ateliers.</h1>
      <div>
        <p>Des ateliers d’archéologie textile pour les musées, les sites archéologiques et les collectivités.</p>
        <Button href="/calendrier/" variant="light">Voir les prochaines dates</Button>
      </div>
    </div>
  </section>

  <section class="intro paper-section">
    <img src="/images/neotisse-logo-noir_IJXv.png" alt="Logo Néotisse" width="290" height="282" loading="lazy" />
    <p>Néotisse est une association fondée en 2024 par deux archéologues, Émilie Roma-Sert et Marie-Salomé Perrichon. Elles transmettent les savoir-faire textiles du passé aux musées, aux sites archéologiques et aux collectivités.</p>
  </section>

  <section class="promises" aria-label="Les engagements de Néotisse">
    <article class="image-card image-card--montpellier">
      <img src="/images/Atelier-explicatif_IJXv.png" alt="Public réuni autour d’un atelier explicatif" loading="lazy" />
      <div><h2>Fondée à Montpellier</h2><p>Des interventions partout en France</p></div>
    </article>
    <article class="image-card image-card--science">
      <img src="/images/Presentation-materiel-scaled_IJXv.jpg" alt="Présentation du matériel : outils, pesons et fils sur une table" loading="lazy" />
      <div><h2>Rigueur scientifique</h2><p>Des gestes et des outils fondés sur les découvertes archéologiques</p></div>
    </article>
    <article class="image-card image-card--sur-mesure">
      <img src="/images/Atelier-enfant_IJXv.jpg" alt="Enfant tissant des fils rouges et jaunes sur un carton" loading="lazy" />
      <div><h2>Sur mesure</h2><p>Chaque atelier part d’un objet ou d’une technique précise, puis s’adapte à votre lieu et à votre public.</p><Button href="#organiser" variant="dark">Organiser un atelier</Button></div>
    </article>
  </section>

  <section class="partners paper-section" aria-label="Partenaires">
    {[
      ['Logo-Musee-de-Lattes_IJXv.png', 'Musée de Lattes'],
      ['Logo-musee-Gergovie_IJXv.jpg', 'Musée de Gergovie'],
      ['Logo-Universite-Paul-Valery-Montpellier-3_IJXv.webp', 'Université Paul-Valéry Montpellier 3'],
      ['Logo-CERAC_IJXv.webp', 'CERAC'],
      ['Logo-Festival-du-lin_IJXv.webp', 'Festival du lin'],
      ['Logo-Lozere-tourisme_IJXv.png', 'Lozère tourisme'],
    ].map(([src, alt]) => <img src={`/images/${src}`} alt={alt} loading="lazy" />)}
  </section>

  <section class="atelier-feature">
    <div class="atelier-feature__image"><img src="/images/Atelier-explicatif-2_IJXv.jpg" alt="Atelier de médiation textile" loading="lazy" /></div>
    <div class="atelier-feature__content">
      <h2>Nos ateliers</h2>
      <div class="atelier-list">
        {ateliers.map(([title, description, image, alt, id], index) => (
          <details open={index === 0} id={id}>
            <summary>{title}<span aria-hidden="true">↗</span></summary>
            <div class="atelier-detail"><img src={`/images/${image}`} alt={alt} loading="lazy" /><p>{description}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="publics">
    <img src="/images/Atelier-enfant_IJXv.jpg" alt="Atelier ouvert à tous les publics" loading="lazy" />
    <div><h2>Des ateliers ouverts<br />à tous les publics</h2><p>Des ateliers conçus pour transmettre des savoir-faire anciens, dans un cadre adapté à chaque public.</p><div class="button-row"><Button href="#organiser" variant="gold">Organiser un atelier</Button><Button href="/calendrier/" variant="dark">Voir les prochaines dates</Button></div></div>
  </section>

  <section class="dates paper-section">
    <h2>Prochaines dates</h2>
    <div class="dates-grid">
      <div class="dates-list"><p class="eyebrow">À venir</p>{dates.map(([day, month, title, audience]) => <div class="date-row"><strong>{day}<small>{month}</small></strong><p>{title}<small>{audience}</small></p><a href="/calendrier/">S’inscrire <span>↗</span></a></div>)}<Button href="/calendrier/" variant="gold">Voir tout le calendrier</Button></div>
      <article class="event-card"><p>Octobre 2027</p><h3>Festival d’archéologie expérimentale d’Occitanie</h3><span>Musée de l’Aurignacien</span></article>
    </div>
  </section>

  <section class="testimonial">
    <img src="/images/Tissage-aux-tablettes-_XP-ceinture-statues-menhirs__IJXv.jpg" alt="" loading="lazy" />
    <div><h2>Ce qu’ils en disent</h2><blockquote>“Des activités très originales et flexibles, qui plaisent à tous types de public. Je recommande !”</blockquote><p><strong>Directrice anonyme</strong><br />Directrice du musée mystérieux.</p></div>
  </section>

  <section class="contact-section" id="organiser">
    <img src="/images/Jean-Vaquer_-Michel-Maille-et-une-statue-menhir_IJXv.jpg" alt="Jean Vaquer et Michel Maillé devant une statue-menhir" loading="lazy" />
    <div class="contact-copy"><h2>Organiser<br />un atelier</h2><p>Décrivez votre lieu et votre public, nous revenons vers vous avec une proposition.</p><a href="mailto:asso.neotisse@gmail.com">asso.neotisse@gmail.com</a></div>
    <div class="contact-form"><h3>Parlez-nous de votre projet</h3><form action="#" method="post" onsubmit="return false"><p class="form-note">Le formulaire sera activé avec Formspree avant la mise en ligne.</p><div class="form-grid">{[['nom','Nom','Votre nom','text',true],['structure','Structure','Musée, site, collectivité…','text',false],['email','Email','nom@structure.fr','email',true],['telephone','Téléphone','06 00 00 00 00','tel',false],['date','Date souhaitée','Mois ou période','text',false],['participants','Participants','Nombre approximatif','text',false],['public','Public','Type de public','text',false],['message','Message','Votre projet','textarea',true]].map(([name,label,placeholder,type,required]) => <label class={name === 'message' ? 'wide' : ''}>{label}{type === 'textarea' ? <textarea name={name} placeholder={placeholder} required={required}></textarea> : <input name={name} type={type} placeholder={placeholder} required={required} />}</label>)}</div><div class="form-footer"><label><input type="checkbox" required /> J’accepte la <a href="/confidentialite/">politique de confidentialité</a></label><button type="submit" class="button button--gold">Envoyer <span class="button__arrow">↗</span></button></div></form></div>
  </section>
</BaseLayout>
